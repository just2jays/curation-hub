PB_VERSION=0.39.10
PORT=3001

# Optional: set both values to create/update the PocketBase superuser on startup.
# Leave both unset to use PocketBase's one-time installer flow.
# (See logs on first run for the generated superuser credentials.)
# PB_SUPERUSER_EMAIL=admin@example.com
# PB_SUPERUSER_PASSWORD=replace-with-a-long-random-password